<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="9.7.0">
<layerstackup name="JLC 2-layer 1.6mm" type="Standard Stackup" version="V2" display_unit="mic" roughness_model="1" allow_instack_material_edit="yes">
